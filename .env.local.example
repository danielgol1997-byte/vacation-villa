# Required for the voice assistant ("היי וילה" → AI command parsing).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional. If unset, /api/state falls back to in-memory storage
# (resets on each deploy). For production, set this and link a Blob store.
# BLOB_READ_WRITE_TOKEN=
